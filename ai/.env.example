# AI Service Environment Configuration

# --- Groq / OpenAI-compatible Cloud LLM ---
OPENAI_API_KEY=your_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Local Ollama Alternative ---
OLLAMA_MODEL=qwen2.5:7b

# --- Vector Database (Qdrant) ---
# Leave empty for automatic in-memory mode, or provide remote cluster:
QDRANT_URL=your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=research_papers

# --- Internal Service Authentication ---
AI_SERVICE_SECRET=ros-internal-service-token-dev
LOG_LEVEL=INFO
