generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id               String            @id @default(uuid())
  userId           String
  name             String
  topic            String
  paperLimit       Int               @default(20)
  status           ProjectStatus     @default(QUEUED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers           Paper[]
  reports          Report[]
  agentRuns        AgentRun[]
  gapCandidates    GapCandidate[]
  paperComparisons PaperComparison[]

  @@index([userId])
}

enum ProjectStatus {
  QUEUED
  DISCOVERING
  INGESTING
  ANALYZING
  REPORTING
  COMPLETE
  ERROR
}

model Paper {
  id             String            @id @default(uuid())
  projectId      String
  externalId     String
  source         PaperSource
  title          String
  authors        String[]
  year           Int?
  venue          String?
  abstractText   String?
  pdfUrl         String?
  citationCount  Int               @default(0)
  summaryProblem String?
  summaryMethod  String?
  summaryDataset String?
  summaryResults String?
  summaryLimits  String?
  bookmarked     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gapEvidence    GapEvidence[]
  comparisons    PaperComparison[]

  @@index([projectId])
  @@index([externalId])
}

enum PaperSource {
  SEMANTIC_SCHOLAR
  ARXIV
  OPENALEX
}

model Report {
  id         String   @id @default(uuid())
  projectId  String   @unique
  content    String
  isPublic   Boolean  @default(false)
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id           String      @id @default(uuid())
  projectId    String
  agentName    AgentName
  status       AgentStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  errorMessage String?
  metadata     Json?
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum AgentName {
  DISCOVERY
  INGESTION
  ANALYSIS
  GAPS
  REPORT
}

enum AgentStatus {
  PENDING
  RUNNING
  COMPLETE
  ERROR
  SKIPPED
}

model GapCandidate {
  id                String              @id @default(uuid())
  projectId         String
  topicA            String
  topicB            String
  statement         String
  coOccurrenceScore Float
  alpha             Float
  beta              Float
  validationStatus  GapValidationStatus @default(INCONCLUSIVE)
  createdAt         DateTime            @default(now())
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence          GapEvidence[]

  @@index([projectId])
}

enum GapValidationStatus {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  INCONCLUSIVE
}

model GapEvidence {
  id           String           @id @default(uuid())
  candidateId  String
  paperId      String?
  paperTitle   String?
  passage      String
  pageNumber   Int?
  sectionTitle String?
  relation     EvidenceRelation @default(UNCLEAR)
  createdAt    DateTime         @default(now())
  candidate    GapCandidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  paper        Paper?           @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([paperId])
}

enum EvidenceRelation {
  SUPPORTS
  CONTRADICTS
  PARTIALLY_SUPPORTS
  ADDRESSES_ALREADY
  UNCLEAR
}

model PaperComparison {
  id          String   @id @default(uuid())
  projectId   String
  paperId     String
  question    String?
  methodology String?
  dataset     String?
  metrics     String?
  findings    String?
  limitations String?
  futureWork  String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  paper       Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([projectId, paperId])
  @@index([projectId])
}
